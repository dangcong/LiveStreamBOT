                                <a href="javascript:window.print()" class="btn btn-dark waves-effect waves-light"><i class="fa fa-print"></i></a>
                                <button id="btn-confirm-payment" type="button" class="btn btn-primary waves-effect waves-light">Thanh toán</button>
                            </div>
                        </div>
                        <form id="form-invoice">
                            <input type="hidden" name="invoiceId" id="iv" value="MINHYEN97-LIVE1-12" />
                            <input type="hidden" name="month" value="3" class="month" />
                            <input type="hidden" name="price" value="200000" class="price" />
                            <input type="hidden" name="package_code" value="LIVE1" />
                            <input type="hidden" name="_token" value="DKgv8uzdV2sece2ehFRl6vYA4fX8p67L1kbQ2QBi" />
