<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config nguồn: SDK publish sẽ tự chèn <handlers> + <aspNetCore> (processPath/arguments/hostingModel)
  vào <system.webServer>, giữ nguyên phần bên dưới.
  Mục đích: nâng giới hạn upload của IIS cho API cập nhật bot (BotUpdateController.Publish).
  - requestLimits/maxAllowedContentLength: giới hạn request filtering của IIS (mặc định ~28.6MB),
    KHÔNG bị [DisableRequestSizeLimit] tác động. Đặt ~4GB (uint max) cho file zip publish lớn.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
