@model ProfifleInfoDto
@{
    ViewData["Title"] = "Thông tin người dùng";
    var orders = ViewBag.Orders as List<OrderInfoDto>;

}

<section class="section">
    <div class="section-header">
        <h1>User</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item"><a href="#">Components</a></div>
            <div class="breadcrumb-item">User</div>
        </div>
    </div>

    <div class="section-body">

        <div class="row">
            <div class="col-12 col-sm-12 col-lg-6">
                <div class="card author-box card-primary">
                    <div class="card-body">
                        <div class="author-box-left">
                            <img alt="image" src="/admin-themes/assets/img/avatar/avatar-1.png" class="rounded-circle author-box-picture">
                            <div class="clearfix"></div>
                            <button class="mt-3 btn btn-success " data-toggle="modal" data-target="#updateModal">Cập nhật Telegram/Discord</button>
                            <a href="/account/changePassword" class="btn btn-danger mt-3 ">Đổi mật khẩu</a>
                        </div>
                        <div class="author-box-details">
                            <div class="author-box-name">
                                <a href="#">@Model.UserName</a>
                            </div>
                            <div class="author-box-job">Người dùng</div>
                            <div class="author-box-description">

                                @* <p>
                                <strong>Số điện thoại: </strong>
                                <span>@Model.Phone</span>
                                </p>*@
                                <p>
                                    <strong>Telegram: </strong>
                                    <span><a href="#">@Model.TelegramUserId</a></span>
                                </p>
                                <p>
                                    <strong>Discord: </strong>
                                    <span><a href="#">@Model.DiscordUserId</a></span>
                                </p>
                                @* <h2 class="section-title">Gói LIVE-1080</h2>
                                <p>
                                <strong>Gói đang sử dụng: </strong>
                                <span>LIVE</span>

                                </p>
                                <p>
                                <strong>Được tạo: </strong>
                                <span>5 luồng live</span>
                                </p>
                                <p>
                                <strong>Số luồng chạy đồng thời: </strong>
                                <span>5 luồng live</span>
                                </p>
                                <p>
                                <strong>Ngày đăng ký LIVE-1080: </strong>
                                <span>@(Model.PackageLive1080?.CreatedTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</span>
                                </p>
                                <p>
                                <strong>Ngày hết hạn LIVE-1080: </strong>
                                <span>@(Model.PackageLive1080?.ExpiredTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</span>
                                </p>
                                <h2 class="section-title">Gói LIVE-4K</h2>
                                <p>
                                <strong>Được tạo: </strong>
                                <span>5 luồng live</span>
                                </p>
                                <p>
                                <strong>Số luồng chạy đồng thời: </strong>
                                <span>5 luồng live</span>
                                </p>*@
                                @* <p>
                                <strong>Ngày đăng ký LIVE-4K: </strong>
                                <span>@(Model.PackageLive4k?.CreatedTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</span>
                                </p>
                                <p>
                                <strong>Ngày hết hạn LIVE-4K: </strong>
                                <span>@(Model.PackageLive4k?.ExpiredTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</span>
                                </p>*@

                            </div>
                            <a href="#" class="btn btn-social-icon btn-facebook mr-1">
                                <i class="fab fa-facebook-f"></i>
                            </a>

                        </div>
                    </div>
                </div>

            </div>
            <div class="col-12 col-sm-12 col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h4>Thông tin Số luồng đang chạy</h4>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled user-progress list-unstyled-border list-unstyled-noborder">
                            <li class="media">

                                <div class="media-body">
                                    <div class="media-title">Số luồng LIVE 1080 đang chạy</div>

                                </div>
                                <div class="media-progressbar">
                                    <div class="progress-text">@(Model.PackageLive1080.NumberOfThreadsInRun)/@(Model.PackageLive1080.NumberOfThreads)</div>
                                    <div class="progress" data-height="6">
                                        <div class="progress-bar bg-primary" data-width="@(Model.PackageLive1080.PercentNumberOfThreads)%"></div>
                                    </div>
                                </div>

                            </li>
                            <li class="media">

                                <div class="media-body">
                                    <div class="media-title">Số luồng LIVE 1080 đã tạo</div>

                                </div>
                                <div class="media-progressbar">
                                    <div class="progress-text">@(Model.PackageLive1080.NumberOfThreadsCreatedInRun)/@(Model.PackageLive1080.NumberOfThreadsCreated)</div>
                                    <div class="progress" data-height="6">
                                        <div class="progress-bar bg-primary" data-width="@(Model.PackageLive1080.PercentNumberOfThreadsCreated)%"></div>
                                    </div>
                                </div>

                            </li>
                            <li class="media">

                                <div class="media-body">
                                    <div class="media-title">Số luồng LIVE-4k đang chạy</div>

                                </div>
                                <div class="media-progressbar">
                                    <div class="progress-text">@(Model.PackageLive4k.NumberOfThreadsInRun)/@(Model.PackageLive4k.NumberOfThreads)</div>
                                    <div class="progress" data-height="6">
                                        <div class="progress-bar bg-primary" data-width="@(Model.PackageLive4k.PercentNumberOfThreads)%"></div>
                                    </div>
                                </div>

                            </li>
                            <li class="media">

                                <div class="media-body">
                                    <div class="media-title">Số luồng LIVE-4k đã tạo</div>

                                </div>
                                <div class="media-progressbar">
                                    <div class="progress-text">@(Model.PackageLive4k.NumberOfThreadsCreatedInRun)/@(Model.PackageLive4k.NumberOfThreadsCreated)</div>
                                    <div class="progress" data-height="6">
                                        <div class="progress-bar bg-primary" data-width="@(Model.PackageLive4k.PercentNumberOfThreadsCreated)%"></div>
                                    </div>
                                </div>

                            </li>
                        </ul>
                    </div>
                </div>


            </div>
        </div>

        <div class="alert alert-primary">
            <p>* Telegram</p>
            <p>+ Vào link <a target="_blank" href="https://t.me/userinfobot">https://t.me/userinfobot</a> nhấn start để nhận ID</p>
            <p>+ Cập nhập telegram: điền ID</p>
            <p>* Nhận thông báo live:</p>
            <p>+ Vào <a target="_blank" href="http://t.me/ShineLivestreamBot">http://t.me/ShineLivestreamBot</a> ấn (nhấn start) thì mới nhận được thông báo.</p>
            <p></p>
            <p>* Discord</p>
            <p>+ Vào server <a target="_blank" href="https://discord.gg/rDyaqRZhVc">https://discord.gg/rDyaqRZhVc</a></p>
            <p>+ Kiếm bot ở danh sách thành viên bên phải và chat với bot để khởi đầu cuộc trò chuyện</p>
            <p>+ Vào cài đặt người dùng > Nâng cao > Bật chế độ nhà phát triển > bấm ESC</p>
            <p>+ Chuột trái tên tài khoản của mình ở góc dưới trái > Chọn sao chép id người dùng</p>
        </div>

    </div>
</section>
<div class="modal fade" tabindex="-1" role="dialog" id="updateModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật Telegram/Discord </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="updateForm" method="post" action="/account/update">
                <div class="modal-body">
                    <p>User Id Telegram: </p>
                    <input name="@nameof(Model.TelegramUserId)" value="@Model.TelegramUserId" class="form-control" />
                </div>
                <div class="modal-body">
                    <p>User Id Discord: </p>
                    <input name="@nameof(Model.DiscordUserId)" value="@Model.DiscordUserId" class="form-control" />
                </div>
                @if (User.IsInRole("Manager"))
                {
                    <div class="modal-body">
                        <p>User Id Telegram (nhận thông báo từ nhân viên): </p>
                        <input name="@nameof(Model.TelegramUserIdReceiveNotificationsFromStaff)" value="@Model.TelegramUserIdReceiveNotificationsFromStaff" class="form-control" />
                    </div>
                    <div class="modal-body">
                        <p>User Id Discord (nhận thông báo từ nhân viên): </p>
                        <input name="@nameof(Model.DiscordUserIdReceiveNotificationsFromStaff)" value="@Model.DiscordUserIdReceiveNotificationsFromStaff" class="form-control" />
                    </div>
                }

                <div class="modal-footer bg-whitesmoke br">

                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Xác nhận </button>
                </div>
            </form>
        </div>
    </div>
</div>