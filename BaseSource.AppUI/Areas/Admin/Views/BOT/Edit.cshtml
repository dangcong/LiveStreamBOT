@model ManagerBotInfoDto
@{
    ViewData["Title"] = "Chỉnh sửa thông tin BOT";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<section class="section">
    <div class="section-header">
        <h1>Cài đặt</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Chỉnh sửa</a></div>
            <div class="breadcrumb-item">
                BOT
            </div>
        </div>
    </div>
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/admin/bot/edit">
                            <div class="row">

                                <div class="col-12">
                                    <h6>@ViewData["Title"]</h6>
                                    <div class="form-group mb-4">
                                        <label class="">Tên BOT</label>
                                        <div class="">
                                            <input name="Id" type="hidden" value="@ViewBag.Id" />
                                            <input asp-for="Name" value="@Model.Name" placeholder="Tên BOT" class="form-control" />
                                            <span asp-validation-for="Name" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group mb-4">
                                        <label class="">Group</label>
                                        <div class="">
                                            <input asp-for="Group" value="@Model.Group" placeholder="Group" class="form-control" />
                                            <span asp-validation-for="Group" class="text-danger"></span>
                                        </div>
                                    </div>


                                    <div class="form-group mb-4">
                                        <label class="">Chọn loại</label>
                                        <div class="">
                                            <select name="LiveType" asp-for="LiveType" class="form-control">
                                                <option >-- Chọn ---</option>
                                                <option value="1">Loại 1080</option>
                                                <option value="2">Loại 4K</option>
                                            </select>
                                            <span asp-validation-for="LiveType" class="text-danger"></span>
                                        </div>
                                    </div>
                                   
                                </div>

                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label text-md-right col-12 col-md-4 col-lg-4"></label>
                                <div class="buttons col-sm-12 col-md-8">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <button type="submit" class="btn btn-info btn-lg btn-icon btn-setting"><i class="fas fa-check"></i>&ensp;Cập nhật</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        $('body').on('click', '.btn-setting', function () {
            showModal(null, 'updateSetting');
        });
    </script>
}