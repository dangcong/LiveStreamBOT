@{
    ViewData["Title"] = "Invoice";
}
<style>
    .theme--light .card-box {
        background-color: #fff;
        border-color: #fff;
        border-radius: 0.35rem;
        border: 0px;
        box-shadow: 0 1px 2px rgb(0 0 0 / 20%);
    }

    .theme--light .btn-icon {
        background: #ccc;
        color: #000;
        border: none;
        padding: 3px 6px 3px 6px;
    }

    .radius35 {
        border-radius: 0.35rem;
    }

    .btn-month-payment {
        height: 130px;
        width: 170px;
    }

    .cur-point {
        cursor: pointer;
    }

    .m-r-15 {
        margin-right: 15px !important;
    }

    .color-red {
        color: #e93636;
    }

    .color-green {
        color: green;
    }

    .font-18 {
        font-size: 18px;
    }

    #img_bank img {
        width: 120px;
        height: 120px
    }

    .text-line-through {
        text-decoration: line-through;
    }

    .theme--light .btn-icon:hover {
        background: #9f9f9f;
    }

    .theme--light .pricing-box-active {
        /* border: 1px solid #ac3bda !important; */
        box-shadow: inset 0px 0px 0px 1px #ac3bda;
        background: #9f9f9f;
    }
</style>
