@model StreamClientInfoDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thông tin luồng live";

}

<section class="section">
    <div class="section-header">
        <h1>Cấu hình</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item"><a href="#">Cấu hình</a></div>
            <div class="breadcrumb-item">@ViewData["Title"]</div>
        </div>
    </div>
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">

                <div class="card">
                    <form asp-action="Edit" class="needs-validation" novalidate="">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="Id" type="hidden" />
                        <div class="card-header">
                            <h4>Cấu hình</h4>
                        </div>
                        <div class="card-body">
                            <div class="section-title">Cấu hình</div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" disabled id="live1080" value="1" checked="@(Model.LiveType==LiveType._1080)" name="LiveType" class="custom-control-input">
                                <label class="custom-control-label" for="live1080">Live 1080</label>
                            </div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" disabled id="live4k" value="2" checked="@(Model.LiveType==LiveType._4K)" name="LiveType" class="custom-control-input">
                                <label class="custom-control-label" for="live4k">Live 4k</label>
                            </div>
                            <div class="form-group">
                                <label>Tên luồng live</label>
                                <input asp-for="StreamName" disabled placeholder="Đặt tên để gợi nhớ" class="form-control" required>
                                <span asp-validation-for="StreamName" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Tên Bot Live</label>
                                <input value="@(Model.BotName)" class="form-control" disabled />
                               
                            </div>
                            <div class="form-group">
                                <label>Thời gian chờ Backup <span class="text-danger">(Phút)</span></label>
                                <input class="form-control" disabled min="0" required asp-for="TimeBackup" type="number" />
                                <span asp-validation-for="TimeBackup" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Bot Backup</label>
                                 <input value="@(string.IsNullOrWhiteSpace(Model.BotBackupName)?"":$"{Model.BotBackupName} - {Model.BackupGroup}")" class="form-control" disabled />
                            </div>

                            <div style="display:none">
                                <div class="section-title">Nền tảng</div>
                                <div class="custom-control custom-radio custom-control-inline">
                                    <input type="radio" id="youtube" value="1" checked="@(Model.PlatformType==PlatformType.Youtube)" name="PlatformType" class="custom-control-input">
                                    <label class="custom-control-label" for="youtube">Youtube</label>
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Khóa luồng</label>
                                <input class="form-control" required disabled asp-for="StreamKey" />
                                <span asp-validation-for="StreamKey" class="text-danger"></span>
                            </div>

                            <div class="form-group" style="display:none">
                                <label>RTMP</label>
                                <input class="form-control" disabled required asp-for="RTMP" />
                                <span asp-validation-for="RTMP" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label>Link Video</label>
                                <input class="form-control" disabled required asp-for="Video" rows="1" />
                                <span asp-validation-for="Video" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Link Audio</label>
                                <input class="form-control" disabled asp-for="Audio" rows="1" />
                                <span asp-validation-for="Audio" class="text-danger"></span>
                            </div>
                            <div class="section-title">Hẹn lịch -  <span class="text-danger"> * Lưu ý: Live 24.7 thì không chọn thời gian kết thúc</span></div>
                            <div class="form-group">
                                <label>Thời gian bắt đầu</label>
                                <input type="datetime-local" disabled asp-for="StartTimeLive" class="form-control col-6" placeholder="Thời gian bắt đầu">
                            </div>
                            <div class="form-group">
                                <label>Thời gian kết thúc</label>
                                <input type="datetime-local" disabled asp-for="EndTimeLive" class="form-control col-6" placeholder="Thời gian kết thúc">
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>


    </div>
</section>
@section Scripts{
    <script>

    </script>
}


