                            <table class="table table-striped" id="table-all-user">
                                <thead>
                                    <tr>
                                        <th>Người dùng</th>
                                        <th>Biệt danh</th>
                                        <th>Ngày tạo</th>
                                        <th>Email Xác nhận</th>
                                        <th>Xác minh TK</th>
                                        <th>Khóa TK</th>
                                        <th>Khóa Giao dịch</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
