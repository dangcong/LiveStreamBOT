@model ConfigSettingVm
@{
    ViewData["Title"] = "Cài đặt hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<section class="section">
    <div class="section-header">
        <h1>@ViewData["Title"]</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Cài đặt</a></div>
            <div class="breadcrumb-item">Hệ thống</div>
        </div>
    </div>
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/admin/Setting/Edit">
                            <div class="row">

                                <div class="col-12">
                                   
                                    <div class="form-group mb-4">
                                        <label class="">Danh sách Telegram Ids</label>
                                        <div class="">
                                            <input asp-for="Telegrams" placeholder="Nhập danh sách Id telegram(cách nhau bởi dấu,)" class="form-control" />
                                            <span asp-validation-for="Telegrams" class="text-danger"></span>
                                        </div>
                                    </div>
                                   
                                </div>

                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label text-md-right col-12 col-md-4 col-lg-4"></label>
                                <div class="buttons col-sm-12 col-md-8">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <button type="submit" class="btn btn-info btn-lg btn-icon btn-setting"><i class="fas fa-check"></i>&ensp;Cập nhật</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        $(document).ready(function () {
            $('body').on('click', '.btn-setting', function () {
                showModal(null, 'updateSetting');
            });
        }


    </script>
}

