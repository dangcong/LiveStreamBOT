@model List<UserBotDto>
@{
    ViewData["Title"] = "Danh sách Group BOT";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var index = 1;
    var botId = ViewBag.BotId;
    var users = ViewBag.Users as List<UserAdminInfoDto>;
}

<section class="section">
    <div class="section-header">
        <h1>@ViewData["Title"]</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Danh sách </a></div>
            <div class="breadcrumb-item">BOT</div>
        </div>
    </div>

    <div class="section-body">
        <h2 class="section-title">@ViewData["Title"]</h2>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                        <button class="btn btn-success btnAddUser">Thêm User</button>
                        <hr />
                        <h4>
                            Tổng luồng đang chạy/ luồng cấp phép
                            <strong class="badge badge-primary">@(Model.Sum(x => x.NumberOfThreadsInRun))/@(Model.Sum(x => x.NumberOfThreads))</strong>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="table-groupBot">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên Bot</th>
                                        <th>Người dùng</th>
                                        <th>Luồng(Đang chạy/Cấp phép)</th>
                                        <th>Loại</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td> @item.BotName</td>
                                            <td> <a href="/admin/user/managerbot?userId=@(item.UserId)&username=@(item.UserName)" class="">@item.UserName</a></td>
                                            <td>@(item.NumberOfThreadsInRun)/@(item.NumberOfThreads)</td>
                                            <td>@item.Type</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" role="dialog" id="addUserModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm BOT cho người dùng (Nếu BOT đã có không thể thêm mới)</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="addForm" method="post" action="/admin/bot/AddBotToUser">
                <input name="botId" type="hidden" value="@botId" />
                <div class="modal-body">
                    <div class="form-group mb-4">
                        <label class="">Nhập số luồng</label>
                        <div class="">
                            <input name="NumberOfThreads" placeholder="Nhập số luồng cấp phép" required min="1" class="form-control" />
                        </div>
                    </div>


                    <div class="form-group mb-4">
                        <label class="">Tên người dùng</label>
                        <div class="">
                            <select class="form-control select2" name="UserId" required>
                                @foreach (var item in users)
                                {
                                    <option value="@item.Id">@item.UserName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-whitesmoke br">

                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" id="btn-confirm-payment" class="btn btn-danger">Xác nhận </button>

                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            $("#table-groupBot").DataTable({});
        });

        $('body').on('click', '.btnAddUser', function () {
            $('#addUserModal').modal('show');

        });
    </script>
}
