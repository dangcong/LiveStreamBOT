<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config nguồn: SDK publish sẽ cập nhật processPath/arguments của <aspNetCore>,
  giữ nguyên các thuộc tính tùy chỉnh bên dưới.
  Mục đích:
  - requestLimits/maxAllowedContentLength: nâng giới hạn upload của IIS (~4GB) cho BotUpdateController.Publish.
  - aspNetCore/shutdownTimeLimit="0": kill process NGAY khi shutdown/recycle, không chờ graceful timeout
    (mặc định 10s). Giúp deploy/restart API tức thì, tránh treo do background service/SignalR còn giữ.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\BaseSource.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" shutdownTimeLimit="0" />
  </system.webServer>
</configuration>
