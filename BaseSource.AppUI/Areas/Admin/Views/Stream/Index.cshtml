@model List<StreamAdminInfoDto>
@{
    ViewData["Title"] = "Danh sách Luồng Stream";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var report = ViewBag.Report as StreamReportAdminDto;
    var managers = ViewBag.Managers as List<UserAdminInfoDto>;
    var managerChoose = ViewBag.ManagerChooses as List<string>;
    var index = 1;
}
<style>
    @@media (max-width: 767px) {
        .card .card-stats .card-stats-items {
            display: flow;
        }

        .card .card-stats .card-stats-item {
            width: 100%;
        }
    }

</style>
<section class="section">
    <div class="section-header">
        @if (User.IsInRole("Admin"))
        {
            <h1>Chọn manager</h1>

            <div class="section-header-breadcrumb w-75">
                <select class="form-control select2" id="managerChoose" multiple>
                    @foreach (var item in managers)
                    {
                        <option value="@item.Id" selected="@(managerChoose.Any(x=>x==item.Id))">@item.UserName</option>
                    }
                </select>
                <button class="btn btn-primary ml-1" onclick="reloadPage()">Search</button>
            </div>
        }
        else
        {
            <h1>@ViewData["Title"]</h1>
        }

    </div>

    <div class="section-body">

        <div class=" row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card card-statistic-2">
                    <div class="card-stats">
                        <div class="card-stats-title">
                            Báo cáo
                        </div>
                        <div class="card-stats-items">
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreads1080InRun)/@(report.NumberOfThreads1080)/@(report.TotalBOT1080)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-success">1080(Đang chạy/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreads4KInRun)/@(report.NumberOfThreads4K)/@(report.TotalBOT4k)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-danger"> 4k(Đang chạy/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreadsBackupInRun)/@(report.NumberOfThreadsBackupPending)/@(report.NumberOfThreadsBackup)/@(report.TotalBOTBackup)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-warning">Backup(Đang chạy/Chờ/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@(report.TotalBOTConnected)/@(report.TotalBOT)</div>
                                <div class="card-stats-item-label"> <span class="badge badge-primary">BOT</span></div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalUser</div>
                                <div class="card-stats-item-label"> <span class="badge badge-info">Tổng User</span></div>
                            </div>

                        </div>
                    </div>
                    <div>
                        <br />
                        <span></span>
                    </div>


                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="tableAllStream">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Manager</th>
                                        <th>Người dùng</th>
                                        <th>Tên Luồng</th>
                                        <th>Job</th>
                                        <th>BotName</th>
                                        <th>Group</th>
                                        <th>Key</th>
                                        <th>Bot Backup</th>
                                        <th>Kiểu live</th>
                                        <th>Live</th>
                                        <th>Thời gian bắt đầu</th>
                                        <th>Thời gian kết thúc</th>
                                        <th>Thời gian live</th>
                                        <th>Log</th>
                                        <th>Trạng thái</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td>@item.UserManager</td>
                                            <td>
                                                @item.UserName
                                            </td>
                                            <td>@item.StreamName</td>
                                            <td class="stream-job-thumbnail-cell">
                                                <img src="/admin/stream/thumbnail?id=@item.Id"
                                                     alt="Ảnh xem trước: @item.StreamName"
                                                     title="@item.StreamName"
                                                     loading="lazy"
                                                     class="stream-job-thumbnail" />
                                            </td>
                                            <td>@item.BotName</td>
                                            <td>@item.BotGroup</td>
                                            <th>@item.StreamKey</th>
                                            <td>@(item.BotBackupName) - @(item.BotBackupGroup)</td>
                                            <td>
                                                @if (item.LiveType == LiveType._1080)
                                                {
                                                    <span class="badge badge-success">1080</span>
                                                }
                                                else if (item.LiveType == LiveType._4K)
                                                {
                                                    <span class="badge badge-danger">4k</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Backup</span>
                                                }
                                            </td>
                                            <td>

                                                @if (item.EndTimeLive != null)
                                                {
                                                    <span class="badge badge-success">Live 11h</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-primary">24//7</span>
                                                }
                                            </td>
                                            <td>
                                                @(item.StartTimeLive?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")
                                            </td>
                                            <td>
                                                @if (item.EndTimeLive != null)
                                                {
                                                    <span>@item.EndTimeLive?.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                }
                                                else
                                                {
                                                    <span>Vĩnh viễn</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.EndTimeLive != null)
                                                {
                                                    @*<span>@item.EndTimeLive?.ToString("dd/MM/yyyy HH:mm:ss")</span>*@
                                                    <span>@(item.EndTimeLive - item.StartTimeLive)</span>
                                                }
                                                else
                                                {
                                                    <span>Vĩnh viễn</span>
                                                }
                                            </td>
                                            <td>
                                                @switch (item.RenderStatus)
                                                {
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.Created:
                                                        <span class="badge badge-success">Mới</span>
                                                        break;
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.Waitting:
                                                        <span class="badge badge-warning">Chờ</span>
                                                        break;
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.Downloading:
                                                        <span class="badge badge-info">Tải</span>
                                                        break;
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.Rendering:
                                                        <span class="badge badge-info">Rendering</span>
                                                        break;
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.LiveStreaming:
                                                        <span class="badge badge-success">Đang stream</span>
                                                        break;
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.Cancelled:
                                                        <span class="badge badge-danger"> Hủy</span>
                                                        break;
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.Ended:
                                                        <span class="badge badge-danger"> Kết thúc</span>
                                                        break;
                                                    case BaseSouce.SharedSignalrData.Enums.RenderStatus.Error:
                                                        <span class="badge badge-danger"> Lỗi(@item.ErrorMessage)</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @switch (item.Status)
                                                {
                                                    case StreamStatus.Streaming:
                                                        <span class="badge badge-success">Streaming</span>
                                                        break;
                                                    case StreamStatus.Stop:
                                                        <span class="badge badge-danger">Dừng</span>
                                                        break;
                                                    case StreamStatus.Disconnet:
                                                        <span class="badge badge-warning">Disconnect</span>
                                                        break;
                                                }
                                            </td>
                                            <td><a class="btn btn-primary" href="/admin/stream/info?id=@item.Id">Chi tiết</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        $(document).ready(function () {
            $("#tableAllStream").DataTable({

            });
        });

    </script>
}
