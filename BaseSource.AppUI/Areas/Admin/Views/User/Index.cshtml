@model List<UserAdminInfoDto>
@{
    ViewData["Title"] = "Danh sách người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var report = ViewBag.Report as StreamReportAdminDto;
    var managers = ViewBag.Managers as List<UserAdminInfoDto>;
    var managerChoose = ViewBag.ManagerChooses as List<string>;
    var index = 1;
}
<style>
    @@media (max-width: 767px) {
        .card .card-stats .card-stats-items {
            display: flow;
        }

        .card .card-stats .card-stats-item {
            width: 100%;
        }
    }

</style>
<section class="section">
    <div class="section-header">
        @if (User.IsInRole("Admin"))
        {
            <h1>Chọn manager</h1>

            <div class="section-header-breadcrumb w-75">
                <select class="form-control select2" id="managerChoose" multiple>
                    @foreach (var item in managers)
                    {
                        <option value="@item.Id" selected="@(managerChoose.Any(x=>x==item.Id))">@item.UserName</option>
                    }
                </select>
                <button class="btn btn-primary ml-1" onclick="reloadPage()">Search</button>
            </div>
        }
        else
        {
            <h1>Danh sách người dùng</h1>
           
        }


    </div>

    <div class="section-body">

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }

        <div class=" row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card card-statistic-2">
                    <div class="card-stats">
                        <div class="card-stats-title">
                            Báo cáo
                        </div>
                        <div class="card-stats-items">
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreads1080InRun)/@(report.NumberOfThreads1080)/@(report.TotalBOT1080)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-success">1080(Đang chạy/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreads4KInRun)/@(report.NumberOfThreads4K)/@(report.TotalBOT4k)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-danger"> 4k(Đang chạy/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreadsBackupInRun)/@(report.NumberOfThreadsBackupPending)/@(report.NumberOfThreadsBackup)/@(report.TotalBOTBackup)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-warning">Backup(Đang chạy/Chờ/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@(report.TotalBOTConnected)/@(report.TotalBOT)</div>
                                <div class="card-stats-item-label"> <span class="badge badge-primary">BOT</span></div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalUser</div>
                                <div class="card-stats-item-label"> <span class="badge badge-info">Tổng User</span></div>
                            </div>

                        </div>
                    </div>
                    <div>
                        <br />
                        <span></span>
                    </div>


                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header user-list-header">
                        <h4>Danh sách người dùng</h4>
                        <a class="btn btn-success user-list-create-btn" href="/admin/user/create">Tạo mới</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="tableAllUser">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Action</th>
                                        <th>Vai trò</th>
                                        <th>Người dùng</th>
                                        <th>Update</th>
                                        <th>Manager</th>
                                        <th>Luồng 1080(Chạy/Tổng/BOT)</th>
                                        <th>Luồng 4K(Chạy/Tổng/BOT)</th>
                                        <th> Backup(Chạy/Chờ/Tổng/BOT)</th>
                                        <th>Số BOT</th>
                                        <th>Telegram</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td class="user-actions-cell">
                                                <div class="user-row-actions" role="group" aria-label="Thao tác người dùng @item.UserName">
                                                <button type="button" class="btn btn-sm btn-primary btnEditUser"
                                                        data-toggle="modal"
                                                        data-target="#editUserModal"
                                                        data-id="@item.Id"
                                                        data-username="@item.UserName"
                                                        data-telegram="@item.TelegramUserId"
                                                        data-manager="@item.UserManager">
                                                    Edit
                                                </button>
                                                <a class="btn btn-sm btn-success" href="/admin/stream/user?userId=@(item.Id)&username=@(item.UserName)">Stream</a>
                                                <a class="btn btn-sm btn-success" href="/admin/user/managerBot?userId=@(item.Id)&username=@(item.UserName)">BOT</a>
                                                <button type="button" class="btn btn-sm btn-danger btnDelete" data-id="@item.Id">
                                                    Xóa
                                                </button>
                                                </div>
                                            </td>
                                            <td>
                                                @if (item.Roles.Any(x => x == "Admin"))
                                                {
                                                    <span class="badge badge-danger">@(string.Join(",", item.Roles))</span>
                                                }
                                                else if (item.Roles.Any(x => x == "Manager"))
                                                {
                                                    <span class="badge badge-warning">Manager</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">User</span>
                                                }
                                            </td>
                                            <td>@item.UserName</td>
                                            @if (!string.IsNullOrEmpty(item.UserUpdate))
                                            {
                                                <td>[@(item.UserUpdate)- @(item.UpdatedTime?.ToString("dd/MM/yyyy"))]</td>
                                            }
                                            else
                                            {
                                                <td></td>
                                            }
                                            <td>@item.Manager</td>
                                            <td>
                                                <span class="badge badge-success">
                                                    @(item.NumberOfThreads1080InRun)/@(item.NumberOfThreads1080)/@(item.TotalBot1080)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge badge-danger">
                                                    @(item.NumberOfThreads4KInRun)/@(item.NumberOfThreads4K)/@(item.TotalBot4k)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge badge-warning">
                                                    @(item.NumberOfThreadsBackupInRun)/@(item.NumberOfThreadsBackupPending)/@(item.NumberOfThreadsBackup)/@(item.TotalBotBackup)
                                                </span>
                                            </td>
                                            <td>@item.TotalBOT</td>
                                            <td>
                                                <span class="badge badge-primary">T @item.TelegramUserId</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="modal fade" role="dialog" id="editUserModal" aria-labelledby="editUserModalTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formEditUser" action="/admin/User/UpdateBotChatTarget">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalTitle">Chỉnh sửa tài khoản</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input name="UserId" type="hidden" />

                    <div class="form-group">
                        <label for="editUserName">Tên người dùng</label>
                        <input id="editUserName" type="text" name="UserName" required maxlength="256" autocomplete="username" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label for="editUserPassword">Mật khẩu mới</label>
                        <input id="editUserPassword" type="password" name="Password" minlength="6" autocomplete="new-password" placeholder="Để trống nếu không đổi mật khẩu" class="form-control" />
                        <small class="form-text text-muted">Mật khẩu mới cần ít nhất 6 ký tự. Để trống nếu không muốn đổi.</small>
                    </div>

                    <div class="form-group mb-4">
                        <label for="editTelegramUserId">ID Telegram (nhiều ID cách nhau bằng dấu phẩy)</label>
                        <div class="">
                            <input id="editTelegramUserId" type="text"
                                   name="TelegramUserId"
                                   placeholder="Nhập ID Telegram"
                                   class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="form-group mb-4">
                            <label for="editUserManager">Manager</label>
                            <div class="">
                                <div class="">
                                    <select id="editUserManager" name="UserManager" class="form-control select2">
                                        <option value="">Không đổi Manager</option>
                                        @foreach (var item in managers)
                                        {
                                            <option value="@item.Id">@item.UserName</option>
                                        }
                                    </select>

                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="deleteUserModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formDeleteUser" action="/admin/User/Delete">
                <div class="modal-header">
                    <h5 class="modal-title">Xóa người dùng?</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Bạn có muốn xóa người dùng này?</p>
                    <input class="form-control" name="userId" type="hidden" />
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Xác nhận</button>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('body').on('click', '.btnDelete', function () {
                $('#deleteUserModal').modal('show');
                let id = $(this).attr('data-id');
                $('#formDeleteUser input[name="userId"]').val(id);
            });
            $('body').on('click', '.btnEditUser', function () {
                let id = $(this).attr('data-id');
                let userName = $(this).attr('data-username');
                let telegrams = $(this).attr('data-telegram');
                let manager = $(this).attr('data-manager');

                $('#formEditUser input[name="UserId"]').val(id);
                $('#formEditUser input[name="UserName"]').val(userName);
                $('#formEditUser input[name="Password"]').val('');
                $('#formEditUser input[name="TelegramUserId"]').val(telegrams);
                $('#formEditUser select[name="UserManager"]').val(manager || '').trigger('change');
            });




            $("#tableAllUser").DataTable({});
        });


    </script>
}

