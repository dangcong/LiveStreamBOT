@model List<UserAdminInfoDto>
@{
    ViewData["Title"] = "Danh sách người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var report = ViewBag.Report as StreamReportAdminDto;
    var managers = ViewBag.Managers as List<UserAdminInfoDto>;
    var managerChoose = ViewBag.ManagerChooses as List<string>;
    var index = 1;
}
<style>
    @@media (max-width: 767px) {
        .card .card-stats .card-stats-items {
            display: flow;
        }

        .card .card-stats .card-stats-item {
            width: 100%;
        }
    }

</style>
<section class="section">
    <div class="section-header">
        @if (User.IsInRole("Admin"))
        {
            <h1>Chọn manager</h1>

            <div class="section-header-breadcrumb w-75">
                <select class="form-control select2" id="managerChoose" multiple>
                    @foreach (var item in managers)
                    {
                        <option value="@item.Id" selected="@(managerChoose.Any(x=>x==item.Id))">@item.UserName</option>
                    }
                </select>
                <button class="btn btn-primary ml-1" onclick="reloadPage()">Search</button>
            </div>
        }
        else
        {
            <h1>Danh sách người dùng</h1>
           
        }


    </div>

    <div class="section-body">

        <div class=" row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card card-statistic-2">
                    <div class="card-stats">
                        <div class="card-stats-title">
                            Báo cáo
                        </div>
                        <div class="card-stats-items">
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreads1080InRun)/@(report.NumberOfThreads1080)/@(report.TotalBOT1080)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-success">1080(Đang chạy/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreads4KInRun)/@(report.NumberOfThreads4K)/@(report.TotalBOT4k)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-danger"> 4k(Đang chạy/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">
                                    <span>
                                        @(report.NumberOfThreadsBackupInRun)/@(report.NumberOfThreadsBackupPending)/@(report.NumberOfThreadsBackup)/@(report.TotalBOT4k)
                                    </span>
                                </div>
                                <div class="card-stats-item-label">
                                    <span class="badge badge-warning">Backup(Đang chạy/Chờ/Tổng/BOT)</span>
                                </div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@(report.TotalBOTConnected)/@(report.TotalBOTDisconnected)</div>
                                <div class="card-stats-item-label"> <span class="badge badge-primary">Connected/Disconnected</span></div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalUser</div>
                                <div class="card-stats-item-label"> <span class="badge badge-info">Tổng User</span></div>
                            </div>

                        </div>
                    </div>
                    <div>
                        <br />
                        <span></span>
                    </div>


                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Danh sách người dùng</h4>
                        <a class="btn btn-success" href="/admin/user/create">Tạo mới</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="tableAllUser">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Action</th>
                                        <th>Vai trò</th>
                                        <th>Người dùng</th>
                                        <th>Mật khẩu</th>
                                        <th>Manager</th>
                                        <th>Luồng 1080(Chạy/Tổng/BOT)</th>
                                        <th>Luồng 4K(Chạy/Tổng/BOT)</th>
                                        <th> Backup(Chạy/Chờ/Tổng/BOT)</th>
                                        <th>Số BOT</th>
                                        <th>Telegram</th>
                                        <th>Teleram QL</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td>
                                                <button class="btn btn-primary btnTelegram" data-tele="@item.LinkTelegram"
                                                        data-id="@item.Id"
                                                        data-manager="@item.UserManager"
                                                @*data-toggle="modal" data-target="#telegramModal"*@>
                                                    Edit
                                                </button>
                                                <a class="btn btn-success" href="/admin/stream/user?userId=@(item.Id)&username=@(item.UserName)">DS Stream</a>
                                                <a class="btn btn-success" href="/admin/user/managerBot?userId=@(item.Id)&username=@(item.UserName)">DS BOT</a>
                                                <button class="btn btn-danger btnDelete" data-id="@item.Id"
                                                @*data-toggle="modal" data-target="#deleteUserModal"*@>
                                                    Xóa
                                                </button>
                                                <button class="btn btn-warning btnResetPassword"
                                                        data-id="@item.Id"
                                                        data-user="@item.UserName">
                                                    Reset Pass
                                                </button>
                                            </td>
                                            <td>
                                                @if (item.Roles.Any(x => x == "Admin"))
                                                {
                                                    <span class="badge badge-danger">@(string.Join(",", item.Roles))</span>
                                                }
                                                else if (item.Roles.Any(x => x == "Manager"))
                                                {
                                                    <span class="badge badge-warning">Manager</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">User</span>
                                                }
                                            </td>
                                            <td>@item.UserName</td>
                                            @if (!string.IsNullOrEmpty(item.UserUpdate))
                                            {
                                                <td>[@(item.UserUpdate)- @(item.UpdatedTime?.ToString("dd/MM/yyyy"))]</td>
                                            }
                                            else
                                            {
                                                <td></td>
                                            }
                                            <td>@item.Manager</td>
                                            <td>
                                                <span class="badge badge-success">
                                                    @(item.NumberOfThreads1080InRun)/@(item.NumberOfThreads1080)/@(item.TotalBot1080)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge badge-danger">
                                                    @(item.NumberOfThreads4KInRun)/@(item.NumberOfThreads4K)/@(item.TotalBot4k)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge badge-warning">
                                                    @(item.NumberOfThreadsBackupInRun)/@(item.NumberOfThreadsBackupPending)/@(item.NumberOfThreadsBackup)/@(item.TotalBotBackup)
                                                </span>
                                            </td>
                                            <td>@item.TotalBOT</td>
                                            <td><span class="badge badge-primary">@item.TelegramAPI</span></td>
                                            <td><span class="badge badge-danger">@item.LinkTelegram</span></td>


                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="modal fade" role="dialog" id="telegramModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formTelegram" action="/admin/User/UpdateTelegram">
                <div class="modal-header">
                    <h5 class="modal-title">Cập nhật </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input name="UserId" type="hidden" />

                    <div class="form-group mb-4">
                        <label class="">ID telegram(cách nhau ,)</label>
                        <div class="">
                            <input type="text"
                                   name="Telegram"
                                   placeholder="Nhập danh sách ID Telegram"
                                   class="form-control"
                                   style="height:100px" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="form-group mb-4">
                            <label class="">Manager <span class="text-danger">(Nếu người dùng là Manager, không chọn dòng này)</span></label>
                            <div class="">
                                <div class="">
                                    <select name="UserManager" required class="form-control select2">
                                        <option>-- Chọn ---</option>
                                        @foreach (var item in managers)
                                        {
                                            <option value="@item.Id">@item.UserName</option>
                                        }
                                    </select>

                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" role="dialog" id="createUserModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formcreateUser" action="/admin/User/Create">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm mới người dùng</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-4">
                        <label class="">UserName</label>
                        <div class="">
                            <input name="UserName" placeholder="Nhập username người dùng" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Mật khẩu</label>
                        <div class="">
                            <input name="Password" placeholder="Nhập mật khẩu người dùng" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Nhập số luồng 1080</label>
                        <div class="">
                            <input type="number" name="NumberOfThreads1080" placeholder="Nhập số luồng 1080 tối đa" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Nhập số luồng 4k</label>
                        <div class="">
                            <input type="number" name="NumberOfThreads1080" placeholder="Nhập số luồng 4k tối đa" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Link telegram</label>
                        <div class="">
                            <input type="number" name="LinkTelegram" placeholder="Nhập link telegram" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Tạo mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="deleteUserModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formDeleteUser" action="/admin/User/Delete">
                <div class="modal-header">
                    <h5 class="modal-title">Xóa người dùng?</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Bạn có muốn xóa người dùng này?</p>
                    <input class="form-control" name="userId" type="hidden" />
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Xác nhận</button>

                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="resetPasswordModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formResetPassword" action="/admin/User/ResetPassword">
                <div class="modal-header">
                    <h5 class="modal-title">Reset mật khẩu người dùng :<span class="text-danger text-userName"></span></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-4">
                        <label class="">Nhập mật khẩu mới</label>
                        <div class="">
                            <input name="Password" required placeholder="Nhập mật khẩu mới" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <input class="form-control" name="userId" type="hidden" />
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Xác nhận</button>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#tableAllUser").DataTable({});

            $('body').on('click', '.btnReset', function () {
                let id = $(this).attr('data-id');
                $('#formResetPassword input[name="userId"]').val(id);
            });
            $('body').on('click', '.btnDelete', function () {
                $('#deleteUserModal').modal('show');
                let id = $(this).attr('data-id');
                $('#formDeleteUser input[name="userId"]').val(id);
            });
            $('body').on('click', '.btnTelegram', function () {
                $('#telegramModal').modal('show');

                let id = $(this).attr('data-id');
                let telegrams = $(this).attr('data-tele');
                let manager = $(this).attr('data-manager');

                $('#formTelegram input[name="UserId"]').val(id);
                $('#formTelegram input[name="Telegram"]').val(telegrams);
                $('#formTelegram select[name="UserManager"]').val(manager);
            });

            $('body').on('click', '.btnResetPassword', function () {
                let id = $(this).attr('data-id');
                let user = $(this).attr('data-user');
                $('.text-userName').html(user);
                $('#formResetPassword input[name="userId"]').val(id);
                $('#resetPasswordModal').modal('show');
                //$('#telegramModal').modal('show');


                //let telegrams = $(this).attr('data-tele');
                //$('#formTelegram input[name="UserId"]').val(id);
                //$('#formTelegram input[name="Telegram"]').val(telegrams);
            });




        });


    </script>
}

