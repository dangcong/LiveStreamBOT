@model UserManagerBotDto
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cập nhật BOT cho người dùng";
    var bots = ViewBag.Bots as List<ManagerBotInfoDto>;
    var bot1080 = bots.Where(x => x.LiveType == LiveType._1080).ToList();
    var bot4k = bots.Where(x => x.LiveType == LiveType._4K).ToList();
}

<section class="section">
    <div class="section-header">
        <h1>Cài đặt</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Chỉnh sửa</a></div>
            <div class="breadcrumb-item">
                @ViewData["Title"]
            </div>
        </div>
    </div>
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/admin/user/managerbot">
                            <div class="row">

                                <div class="col-12">
                                    <h6>@ViewData["Title"]</h6>
                                    <div class="form-group mb-4">
                                        <label class="">Số luồng 1080 cho phép</label>
                                        <div class="">
                                            <input asp-for="UserId" style="display:none;" />
                                            <input asp-for="NumberOfThreads1080" min="0" placeholder="Nhập số luồng 1080 cho phép" class="form-control" />
                                            <span asp-validation-for="NumberOfThreads1080" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group mb-4">
                                        <label class="">BOT 1080 </label>
                                        <div class="">
                                            <select class="form-control" asp-for="Bot1080">
                                                <option value="0">-- Chọn bot --</option>
                                                @foreach (var item in bot1080)
                                                {
                                                    <option value="@item.Id">@item.Name (@(item.NumberOfThreadsInRun)/@(item.NumberOfThreads))</option>
                                                }

                                            </select>

                                            <span asp-validation-for="Bot1080" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="form-group mb-4">
                                        <label class="">Số luồng 4K cho phép</label>
                                        <div class="">
                                            <input asp-for="NumberOfThreads4K" min="0" placeholder="Nhập số luồng 4k cho phép" class="form-control" />
                                            <span asp-validation-for="NumberOfThreads4K" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="form-group mb-4">
                                        <label class="">BOT 4k </label>
                                        <div class="">
                                            <select class="form-control" asp-for="Bot4K">
                                                <option value="0">-- Chọn bot --</option>
                                                @foreach (var item in bot4k)
                                                {
                                                    <option value="@item.Id">@item.Name (@(item.NumberOfThreadsInRun)/@(item.NumberOfThreads))</option>
                                                }

                                            </select>

                                            <span asp-validation-for="Bot4K" class="text-danger"></span>
                                        </div>
                                    </div>


                                </div>

                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label text-md-right col-12 col-md-4 col-lg-4"></label>
                                <div class="buttons col-sm-12 col-md-8">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <button type="submit" class="btn btn-info btn-lg btn-icon btn-setting"><i class="fas fa-check"></i>&ensp;Cập nhật</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        $('body').on('click', '.btn-setting', function () {
            showModal(null, 'updateSetting');
        });
    </script>
}
