@model UserCreateAdminDto
@{
    ViewData["Title"] = "Tạo mới người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<section class="section">
    <div class="section-header">
        <h1>Cài đặt</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Người dùng</a></div>
            <div class="breadcrumb-item">
                @ViewData["Title"]
            </div>
        </div>
    </div>
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/admin/user/create">
                            <div class="row">

                                <div class="col-12">
                                    <h6>@ViewData["Title"]</h6>
                                    <div class="form-group mb-4">
                                        <label class="">UserName</label>
                                        <div class="">
                                            
                                            <input asp-for="UserName"  placeholder="Nhập username người dùng" class="form-control" />
                                            <span asp-validation-for="UserName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group mb-4">
                                        <label class="">Mật khẩu</label>
                                        <div class="">
                                            <input asp-for="Password" placeholder="Nhập mật khẩu người dùng" class="form-control" />
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                        </div>
                                    </div>

                                    @*<div class="form-group mb-4">
                                        <label class="">Số luồng 1080 tối đa</label>
                                        <div class="">
                                            <input type="number" min="1" asp-for="NumberOfThreads1080" class="form-control" />
                                            <span asp-validation-for="NumberOfThreads1080" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="form-group mb-4">
                                        <label class="">Số luồng 4k tối đa</label>
                                        <div class="">
                                            <input type="number" min="1" asp-for="NumberOfThreads4K" class="form-control" />
                                            <span asp-validation-for="NumberOfThreads4K" class="text-danger"></span>
                                        </div>
                                    </div>*@
                                    <div class="form-group mb-4">
                                        <label class="">Telegram</label>
                                        <div class="">
                                            <input  asp-for="LinkTelegram" class="form-control" />
                                            <span asp-validation-for="LinkTelegram" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="form-group row mb-4">
                                <label class="col-form-label text-md-right col-12 col-md-4 col-lg-4"></label>
                                <div class="buttons col-sm-12 col-md-8">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <button type="submit" class="btn btn-info btn-lg btn-icon btn-setting"><i class="fas fa-check"></i>&ensp;Thêm mới</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        //$('body').on('click', '.btn-setting', function () {
        //    showModal(null, 'updateSetting');
        //});
    </script>
}