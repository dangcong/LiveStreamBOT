@model PagedResult<ManagerBotInfoDto>
@{
    ViewData["Title"] = "Danh sách BOT";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var report = ViewBag.Report as StreamReportAdminDto;
    var managers = ViewBag.Managers as List<UserAdminInfoDto>;
    var index = 1;

}

<section class="section">
    <div class="section-header">
        <h1>@ViewData["Title"]</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Danh sách </a></div>
            <div class="breadcrumb-item">BOT</div>
        </div>
    </div>

    <div class="section-body">
        <h2 class="section-title">@ViewData["Title"]</h2>
        <div class=" row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card card-statistic-2">
                    <div class="card-stats">
                        <div class="card-stats-title">
                            Báo cáo
                        </div>
                        <div class="card-stats-items">
                            <div class="card-stats-item">
                                <div class="card-stats-item-count"><span class="badge badge-success">@(report.NumberOfThreads1080InRun)/@(report.NumberOfThreads1080)</span></div>
                                <div class="card-stats-item-label">Tổng số luồng 1080(Đang chạy/Tổng)</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count"><span class="badge badge-danger">@(report.NumberOfThreads4KInRun)/@(report.NumberOfThreads4K)</span></div>
                                <div class="card-stats-item-label">Tổng số luồng 4k(Đang chạy/Tổng)</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalBOT</div>
                                <div class="card-stats-item-label">Tổng BOT</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalUser</div>
                                <div class="card-stats-item-label">Tổng User</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalManager</div>
                                <div class="card-stats-item-label">Tổng TK Quản lý</div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <br />
                        <span></span>
                    </div>


                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                   

                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="table-all-user">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>BotID</th>
                                        <th>Loại</th>
                                        <th>Name</th>
                                        <th>Manager</th>
                                        <th>Group</th>
                                        <th>Status</th>
                                        <th>Ngày tạo</th>
                                        <th>Số luồng</th>
                                        <th>Số User</th>
                                        <th>CPU</th>
                                        <th>RAM</th>
                                        <th>Bandwidth</th>
                                        <th>Space</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td> <span class="text-sm" style="font-size:10px">@item.BotId</span></td>
                                            <td>
                                                @switch (item.LiveType)
                                                {
                                                    case LiveType._1080:
                                                        <span class="badge badge-success">1080</span>
                                                        break;
                                                    case LiveType._4K:
                                                        <span class="badge badge-danger">4k</span>
                                                        break;
                                                }
                                            </td>
                                            <td>@item.Name</td>
                                            <td>@item.Manager</td>
                                            <td>@item.Group</td>
                                            <td>
                                                @switch (item.Status)
                                                {
                                                    case ManagerBOTStatus.Connected:
                                                        <span class="badge badge-success">Connected</span>
                                                        break;
                                                    case ManagerBOTStatus.Disconnected:
                                                        <span class="badge badge-danger">Connected</span>
                                                        break;
                                                }
                                                @item.Status
                                            </td>
                                            <td>@item.CreatedTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td><span>@(item.NumberOfThreadsInRun)/@(item.NumberOfThreads)</span> </td>
                                            <td>@item.TotalUser</td>
                                            <td>@((item.CPU * 100).ToString("n2"))%</td>
                                            <td>@((item.RAM * 100).ToString("n2"))%</td>
                                            <td>@item.Bandwidth.ToString("n2") KB/s</td>
                                            <td><span class="badge badge-success">@((item.DiskUsed / 1024.0 / 1024 / 1024).ToString("n2"))GB/@((item.DiskTotal / 1024.0 / 1024 / 1024).ToString("n2"))GB</span></td>
                                            <td>
                                                <a class="btn btn-info" href="/admin/bot/group?id=@(item.Id)">DS User</a>
                                                @*  <a class="btn btn-primary" href="/admin/bot/edit/@(item.Id)">Sửa</a> *@
                                                @if (item.IsUsed)
                                                {
                                                    <button class="btn btn-danger btn-stop"
                                                            data-id="@item.Id">
                                                        Stop
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-success btn-start"
                                                    @* data-toggle="modal" data-target="#startModal"*@
                                                            data-id="@item.Id">
                                                        Start
                                                    </button>
                                                }
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <button class="btn btn-danger btn-Delete"
                                                    @*data-toggle="modal" data-target="#deleteModal" *@
                                                            data-id="@item.Id">
                                                        Xóa
                                                    </button>
                                                }

                                                <button class="btn btn-warning btn-Edit"
                                                        data-name="@item.Name"
                                                        data-group="@item.Group"
                                                        data-manager="@item.UserManager"
                                                        data-type="@((int?)item.LiveType)"
                                                        data-id="@item.Id">

                                                    Edit
                                                </button>
                                            </td>
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" tabindex="-1" role="dialog" id="deleteModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xóa BOT </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Bạn muốn xóa BOT này ? Nếu có luồng đang chạy không thể xóa BOT</p>
            </div>
            <div class="modal-footer bg-whitesmoke br">
                <form id="deleteForm" method="post" action="/admin/bot/delete">
                    <input name="Id" type="hidden" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Xác nhận </button>
                </form>

            </div>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" role="dialog" id="editModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật BOT </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form method="post" action="/admin/bot/edit" id="formEdit">
                <div class="modal-body">

                    <div class="row">

                        <div class="col-12">

                            <div class="form-group mb-4">
                                <label class="">Tên BOT</label>
                                <div class="">
                                    <input name="Id" type="hidden" />
                                    <input name="Name" required value="" placeholder="Tên BOT" class="form-control" />

                                </div>
                            </div>
                            <div class="form-group mb-4">
                                <label class="">Group</label>
                                <div class="">
                                    <input name="Group" value="" placeholder="Group" class="form-control" />
                                </div>
                            </div>
                            <div class="form-group mb-4">
                                <label class="">Chọn loại</label>
                                <div class="">
                                    <select name="LiveType" required class="form-control">
                                        <option>-- Chọn ---</option>
                                        <option value="1">Loại 1080</option>
                                        <option value="2">Loại 4K</option>
                                    </select>

                                </div>
                            </div>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="form-group mb-4">
                                    <label class="">Manager</label>
                                    <div class="">
                                        <div class="">
                                            <select name="UserManager" required class="form-control select2">
                                                <option>-- Chọn ---</option>
                                                @foreach (var item in managers)
                                                {
                                                    <option value="@item.Id">@item.UserName</option>
                                                }
                                            </select>

                                        </div>
                                    </div>
                                </div>
                            }


                        </div>

                    </div>
                    @*  <div class="form-group row mb-4">
                    <label class="col-form-label text-md-right col-12 col-md-4 col-lg-4"></label>
                    <div class="buttons col-sm-12 col-md-8">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <button type="submit" class="btn btn-info btn-lg btn-icon btn-setting"><i class="fas fa-check"></i>&ensp;Cập nhật</button>
                    </div>
                    </div> *@

                </div>
                <div class="modal-footer bg-whitesmoke br">

                    <input name="Id" type="hidden" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Xác nhận </button>


                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" role="dialog" id="startModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận thông tin </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Bạn muốn Start BOT này ?</p>
            </div>
            <div class="modal-footer bg-whitesmoke br">
                <form id="startForm" method="post" action="/admin/bot/ChangeUsed">
                    <input name="Id" type="hidden" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" id="btn-confirm-payment" class="btn btn-danger">Xác nhận </button>
                </form>

            </div>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" role="dialog" id="stopModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận thông tin</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Bạn muốn Stop BOT này(sau khi stop tất cả các luồng sẽ dừng chạy)?</p>
            </div>
            <div class="modal-footer bg-whitesmoke br">
                <form id="stopForm" method="post" action="/admin/bot/ChangeUsed">
                    <input name="Id" type="hidden" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" id="btn-confirm-payment" class="btn btn-danger">Xác nhận </button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            $("#table-all-user").DataTable({});
            $('body').on('click', '.btn-setting', function () {
                showModal(null, 'updateSetting');
            });

            $('body').on('click', '.btn-start', function () {
                $('#startModal').modal('show');
                let id = $(this).attr('data-id');
                $('#stopForm input[name="Id"]').val(id);
                $('#startForm input[name="Id"]').val(id);
            });
            $('body').on('click', '.btn-stop', function () {
                $('#stopModal').modal('show');
                let id = $(this).attr('data-id');
                $('#stopForm input[name="Id"]').val(id);
                $('#startForm input[name="Id"]').val(id);
            });
            $('body').on('click', '.btn-Delete', function () {
                $('#deleteModal').modal('show');

                let id = $(this).attr('data-id');
                $('#deleteForm input[name="Id"]').val(id);

            });
            $('body').on('click', '.btn-Edit', function () {
                console.log('click');
                $('#editModal').modal('show');
                $('#formEdit input[name="Id"]').val($(this).attr('data-id'));
                $('#formEdit input[name="Name"]').val($(this).attr('data-name'));
                $('#formEdit input[name="Group"]').val($(this).attr('data-group'));
                $('#formEdit select[name="LiveType"]').val($(this).attr('data-type'));
                $('#formEdit select[name="UserManager"]').val($(this).attr('data-manager'));
                // let id = $(this).attr('data-id');
                // $('#deleteForm input[name="Id"]').val(id);
            })
        });
    </script>
}
