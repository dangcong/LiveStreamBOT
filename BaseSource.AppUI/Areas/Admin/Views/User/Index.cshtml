@model List<UserAdminInfoDto>
@{
    ViewData["Title"] = "Danh sách người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var report = ViewBag.Report as StreamReportAdminDto;
}
<section class="section">
    <div class="section-header">
        <h1>Danh sách người dùng</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Danh sách người dùng</a></div>
            <div class="breadcrumb-item">Danh sách</div>
        </div>
    </div>

    <div class="section-body">
        <h2 class="section-title">Danh sách người dùng</h2>
        <div class=" row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card card-statistic-2">
                    <div class="card-stats">
                        <div class="card-stats-title">
                            Báo cáo
                        </div>
                        <div class="card-stats-items">
                            <div class="card-stats-item">
                                <div class="card-stats-item-count"><span class="badge badge-success">@(report.NumberOfThreads1080InRun)/@(report.NumberOfThreads1080)</span></div>
                                <div class="card-stats-item-label">Tổng số luồng 1080(Đang chạy/Tổng)</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count"><span class="badge badge-primary">@(report.NumberOfThreads4KInRun)/@(report.NumberOfThreads4K)</span></div>
                                <div class="card-stats-item-label">Tổng số luồng 4k(Đang chạy/Tổng)</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalBOT</div>
                                <div class="card-stats-item-label">Tổng BOT</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalUser</div>
                                <div class="card-stats-item-label">Tổng User</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalManager</div>
                                <div class="card-stats-item-label">Tổng TK Quản lý</div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <br />
                        <span></span>
                    </div>


                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Danh sách người dùng</h4>
                        <a class="btn btn-success" href="/admin/user/create">Tạo mới</a>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="tableAllUser">
                                <thead>
                                    <tr>
                                        <th>Người dùng</th>
                                        <th>Mật khẩu</th>
                                        <th>Luồng 1080(Đang chạy/Tổng)</th>
                                        <th>Luồng 4K(Đang chạy/Tổng)</th>
                                        <th>Telegram</th>
                                        <th>Teleram QL</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.UserName</td>
                                            <td>@item.Password</td>
                                            <td><span class="badge badge-primary">@(item.NumberOfThreads1080InRun)/@(item.NumberOfThreads1080)</span> </td>
                                            <td><span class="badge badge-primary">@(item.NumberOfThreads4KInRun)/@(item.NumberOfThreads4K)</span></td>
                                            <td><span class="badge badge-primary">@item.TelegramAPI</span></td>
                                            <td><span class="badge badge-danger">@item.LinkTelegram</span></td>
                                            <td>
                                                <button class="btn btn-primary btnTelegram" data-tele="@item.LinkTelegram"
                                                        data-id="@item.Id" data-toggle="modal" data-target="#telegramModal">
                                                    Cập nhật ID
                                                </button>
                                                <a class="btn btn-success" href="/admin/stream/user?userId=@(item.Id)&username=@(item.UserName)">DS Stream</a>
                                                <a class="btn btn-success" href="/admin/user/managerBot?userId=@(item.Id)&username=@(item.UserName)">Cập nhật BOT</a>
                                                <button class="btn btn-danger btnDelete" data-id="@item.Id" data-toggle="modal" data-target="#deleteUserModal">Delete</button>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="modal fade" tabindex="-1" role="dialog" id="telegramModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formTelegram" action="/admin/User/UpdateTelegram">
                <div class="modal-header">
                    <h5 class="modal-title">Cập nhật ID</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input name="UserId" type="hidden" />

                    <div class="form-group mb-4">
                        <label class="">ID telegram(cách nhau ,)</label>
                        <div class="">
                            <input type="text" 
                                name="Telegram" 
                                placeholder="Nhập danh sách ID Telegram" 
                                class="form-control"
                                style="height:100px"/>
                            <span class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" tabindex="-1" role="dialog" id="createUserModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formcreateUser" action="/admin/User/Create">
                <div class="modal-header">
                    <h5 class="modal-title">Thêm mới người dùng</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-4">
                        <label class="">UserName</label>
                        <div class="">
                            <input name="UserName" placeholder="Nhập username người dùng" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Mật khẩu</label>
                        <div class="">
                            <input name="Password" placeholder="Nhập mật khẩu người dùng" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Nhập số luồng 1080</label>
                        <div class="">
                            <input type="number" name="NumberOfThreads1080" placeholder="Nhập số luồng 1080 tối đa" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Nhập số luồng 4k</label>
                        <div class="">
                            <input type="number" name="NumberOfThreads1080" placeholder="Nhập số luồng 4k tối đa" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="">Link telegram</label>
                        <div class="">
                            <input type="number" name="LinkTelegram" placeholder="Nhập link telegram" class="form-control" />
                            <span class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Tạo mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="deleteUserModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formDeleteUser" action="/admin/User/Delete">
                <div class="modal-header">
                    <h5 class="modal-title">Xóa người dùng?</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Bạn có muốn xóa người dùng này?</p>
                    <input class="form-control" name="userId" type="hidden" />
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Xác nhận</button>

                </div>
            </form>
        </div>
    </div>
</div>
