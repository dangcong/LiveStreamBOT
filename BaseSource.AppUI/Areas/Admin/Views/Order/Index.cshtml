@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="section">
    <div class="section-header">
        <h1>Lịch sử Mua gói</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item"><a href="#">Lịch sử</a></div>
            <div class="breadcrumb-item">Gói live</div>
        </div>
    </div>

    <div class="section-body">

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Lịch sử giao dịch</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="table-transactions">
                                <thead>
                                    <tr>
                                        <th>Người dùng</th>
                                        <th>Mã hóa đơn</th>
                                        <th>Số tháng</th>
                                        <th>Ngày tạo</th>
                                        <th>Số tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                        
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {

            $("#table-1").DataTable({

            });

            $("#table-transactions").DataTable({
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "/admin/order/GetAll",
                    "type": "POST",
                    "datatype": "json"
                },
                //"language": {
                //    "url": "/language/language.json"
                //},
                "columnDefs": [
                    {
                        "targets": [1],
                        "searchable": false,
                        "orderable": false
                    }],
                "columns": [
                    { "data": "userName", "name": "UserName", "autoWidth": true },
                    { "data": "orderId", "name": "OrderId", "autoWidth": true },
                    { "data": "month", "name": "Month", "autoWidth": true },
                    { "data": "createdTimeString", "name": "CreatedTimeString", "autoWidth": true },
                    { "data": "price", "name": "Price", "autoWidth": true },
                    {
                        "data": "status", "name": "Status", "autoWidth": true,
                        "render": function (data) {
                            switch (data) {
                                case 1:
                                    return `<div class="badge badge-success">Thành công</div>`;
                                case 2:
                                    return `<div class="badge badge-primary">Chờ xử lý</div>`;
                                case 3:
                                    return `<div class="badge badge-danger">Đã hủy</div>`;
                            }


                        }
                    },
                    {
                        "data": "status", "name": "Status", "autoWidth": true,
                        "render": function (data,row,type) {
                            switch (data) {
                                case 2:
                                    return `<a class="btn btn-primary" href="/admin/order/Info?id=${type.id}">Thao tác</a>`;
                            }
                            return '';
                        }
                    },
                ]
            });
        });
    </script>
}

