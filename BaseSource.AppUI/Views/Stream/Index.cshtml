@model StreamCreateDto
@{
    ViewData["Title"] = "Thuê SMS";
}
<section class="section">
    <div class="section-header">
        <h1>Cấu hình</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item"><a href="#">Cấu hình</a></div>
            <div class="breadcrumb-item">Cấu hình LIVE</div>
        </div>
    </div>

    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">

                <div class="card">
                    <form asp-action="Create" class="needs-validation" novalidate="">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="card-header">
                            <h4>Cấu hình</h4>

                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Tên luồng live</label>
                                <div class="col-sm-9">
                                    <input type="number" asp-for="StreamName" placeholder="Đặt tên để gợi nhớ" class="form-control" required="">
                                    <span asp-validation-for="StreamName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Nền tảng</label>
                                <div class="col-sm-9">
                                    @* <textarea asp-for="Message" class="form-control" required="" placeholder="Nhập nội dung tin nhắn" rows="4"></textarea>
                                    <span asp-validation-for="Message" class="text-danger"></span>*@
                                </div>
                            </div>
                            <div class="section-title mt-0">Checkbox</div>
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="customCheck1">
                                <label class="custom-control-label" for="customCheck1">Check this custom checkbox</label>
                            </div>

                            <div class="section-title">Checkbox</div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="customRadio1" name="customRadio" class="custom-control-input">
                                <label class="custom-control-label" for="customRadio1">Toggle this custom radio</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="customRadio2" name="customRadio" class="custom-control-input">
                                <label class="custom-control-label" for="customRadio2">Or toggle this other custom radio</label>
                            </div>

                            <div class="section-title">Inline</div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" id="customRadioInline1" name="customRadioInline1" class="custom-control-input">
                                <label class="custom-control-label" for="customRadioInline1">Toggle this custom radio</label>
                            </div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" id="customRadioInline2" name="customRadioInline1" class="custom-control-input">
                                <label class="custom-control-label" for="customRadioInline2">Or toggle this other custom radio</label>
                            </div>

                            <div class="section-title">Disabled</div>
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="customCheckDisabled" disabled>
                                <label class="custom-control-label" for="customCheckDisabled">Check this custom checkbox</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" name="radioDisabled" class="custom-control-input" disabled>
                                <label class="custom-control-label">Toggle this custom radio</label>
                            </div>
                        </div>
                        <div class="card-footer text-right">
                            <button class="btn btn-primary">Thuê</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
