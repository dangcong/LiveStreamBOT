@model List<BaseSource.ViewModels.ServicePackage.ServicePackDto>
@{
    ViewData["Title"] = "ServicePack";
}

<style>
    .pricing-highlight .pricing-title {
        background-color: darkgrey !important;
    }
</style>

<section class="section">


    <div class="section-body">

        <div class="row justify-content-center">
            <div class="col-md-10">

                <div class="row">

                    @foreach (var item in Model)
                    {

                        <div class="col-12 col-md-3 col-lg-3">
                            <div class="pricing pricing-highlight">
                                <div class="pricing-title">
                                    <h4> @item.Name</h4>
                                </div>
                                <div class="pricing-padding">
                                    <div class="pricing-price">
                                        <div><h2>@item.Discount.ToString("N0").Replace(",",".")</h2></div>
                                        <div class="text-danger " style="text-decoration:line-through">
                                            <h6>@item.Price.ToString("N0").Replace(",",".")</h6>
                                        </div>
                                        <div>1 tháng</div>
                                    </div>
                                    <div class="pricing-details">
                                        <div class="pricing-item">
                                            <div class="pricing-item-icon"><i class="fas fa-check"></i></div>
                                            <div class="pricing-item-label">@item.NumberOfThreads LUỒNG SONG SONG</div>
                                        </div>
                                        <div class="pricing-item">
                                            <div class="pricing-item-icon"><i class="fas fa-check"></i></div>
                                            <div class="pricing-item-label">KHÔNG CẦN VPS</div>
                                        </div>
                                        <div class="pricing-item">
                                            <div class="pricing-item-icon"><i class="fas fa-check"></i></div>
                                            <div class="pricing-item-label">KHÔNG CẦN TREO MÁY</div>
                                        </div>
                                        <div class="pricing-item">
                                            <div class="pricing-item-icon"><i class="fas fa-check"></i></div>
                                            <div class="pricing-item-label">LIVE 24/7 VIDEO 4K</div>
                                        </div>
                                        <div class="pricing-item">
                                            <div class="pricing-item-icon"><i class="fas fa-check"></i></div>
                                            <div class="pricing-item-label">HỖ TRỢ MIỄN PHÍ</div>
                                        </div>
                                        <div class="text-center">
                                            <a class="btn btn-danger" href="/live/invoice/@item.Name">Mua ngay</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

