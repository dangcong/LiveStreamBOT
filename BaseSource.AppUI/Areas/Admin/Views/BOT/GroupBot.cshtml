@model List<UserBotDto>
@{
    ViewData["Title"] = "Danh sách Group BOT";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var index = 1;
}

<section class="section">
    <div class="section-header">
        <h1>@ViewData["Title"]</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Danh sách </a></div>
            <div class="breadcrumb-item">BOT</div>
        </div>
    </div>

    <div class="section-body">
        <h2 class="section-title">@ViewData["Title"]</h2>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                        <hr />
                        <h4>
                            Tổng luồng đang chạy/ luồng cấp phép
                            <strong class="badge badge-primary">@(Model.Sum(x => x.NumberOfThreadsInRun))/@(Model.Sum(x => x.NumberOfThreads))</strong>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="table-groupBot">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên Bot</th>
                                        <th>Người dùng</th>
                                        <th>Luồng(Đang chạy/Cấp phép)</th>
                                        <th>Loại</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td> @item.BotName</td>
                                            <td> <a href="/admin/user/managerbot?userId=@(item.UserId)&username=@(item.UserName)" class="">@item.UserName</a></td>
                                            <td>@(item.NumberOfThreadsInRun)/@(item.NumberOfThreads)</td>
                                            <td>@item.Type</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts{
    <script>

        $("#table-groupBot").DataTable({});

    </script>
}
