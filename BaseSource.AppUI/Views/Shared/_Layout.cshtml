                    <span aria-hidden="true">&times;</span>
                    </button>
                    </div>
                    <div class="modal-body">
                    <form method="post" action="/admin/Authenticator/ValidateAuthenticator" id="ValidateAuthenticator">
                    <p>Nhập mã xác thực 2FA để thực hiện thao tác</p>
