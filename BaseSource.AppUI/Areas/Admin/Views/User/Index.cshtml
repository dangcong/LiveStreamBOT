@{
    ViewData["Title"] = "Danh sách người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="section">
    <div class="section-header">
        <h1>Danh sách người dùng</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Danh sách người dùng</a></div>
            <div class="breadcrumb-item">Danh sách</div>
        </div>
    </div>

    <div class="section-body">
        <h2 class="section-title">Danh sách người dùng</h2>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Danh sách người dùng</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="tableAllUser">
                                <thead>
                                    <tr>
                                        <th>Người dùng</th>
                                        <th>Mật khẩu</th>
                                        <th>Email</th>
                                        <th>LinkFB</th>
                                        <th>LinkTelegram</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="modal fade" tabindex="-1" role="dialog" id="resetPassModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form method="post" id="formResetPassword" action="/admin/User/ResetPassword">
                <div class="modal-header">
                    <h5 class="modal-title">Reset mật khẩu của người dùng</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Bạn có muốn Reset mật khẩu của người dùng?</p>
                    <input class="form-control" name="userId" type="hidden" />
                </div>
                <div class="modal-footer bg-whitesmoke br">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Xác nhận</button>

                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#tableAllUser").DataTable({
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "/admin/user/GetAll",
                    "type": "POST",
                    "datatype": "json"
                },
                //"language": {
                //    "url": "/language/language.json"
                //},
                "columnDefs": [
                    {
                        "targets": [1],
                        "searchable": false,
                        "orderable": false
                    }],
                "columns": [
                    { "data": "userName", "name": "UserName", "autoWidth": true },
                    { "data": "password", "name": "Password", "autoWidth": true },
                    { "data": "email", "name": "Email", "autoWidth": true },
                    { "data": "linkFB", "name": "LinkFB", "autoWidth": true },
                    { "data": "linkTelegram", "name": "LinkTelegram", "autoWidth": true },

                    {
                        "data": "userName", "name": "userName", "autoWidth": true,
                        "render": function (data, row, type) {
                            return `<a class="btn btn-primary" href="/admin/order/user?userId=${type.id}">DS Gói</a>
                                     <a class="btn btn-success" href="/admin/stream/user?userId=${type.id}">DS Stream</a>
                                     <button class="btn btn-danger btnReset" data-id="${type.id}"  data-toggle="modal" data-target="#resetPassModal">Reset MK</button>`;
                        }
                    },
                ]
            });
        });
        $('body').on('click', '.btnReset', function () {
            let id = $(this).attr('data-id');
            $('#formResetPassword input[name="userId"]').val(id);
        })
    </script>
}

