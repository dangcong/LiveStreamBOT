@model List<StreamAdminInfoDto>
@{
    ViewData["Title"] = "Danh sách Luồng Stream";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var report = ViewBag.Report as StreamReportAdminDto;
}

<section class="section">
    <div class="section-header">
        <h1>@ViewData["Title"]</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Home</a></div>
            <div class="breadcrumb-item"><a href="#">Danh sách </a></div>
            <div class="breadcrumb-item">Stream</div>
        </div>
    </div>

    <div class="section-body">
        <h2 class="section-title">@ViewData["Title"]</h2>
        <div class=" row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="card card-statistic-2">
                    <div class="card-stats">
                        <div class="card-stats-title">
                            Báo cáo
                        </div>
                        <div class="card-stats-items">
                            <div class="card-stats-item">
                                <div class="card-stats-item-count"><span class="badge badge-success">@(report.NumberOfThreads1080InRun)/@(report.NumberOfThreads1080)</span></div>
                                <div class="card-stats-item-label">Tổng số luồng 1080(Đang chạy/Tổng)</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count"><span class="badge badge-primary">@(report.NumberOfThreads4KInRun)/@(report.NumberOfThreads4KInRun)</span></div>
                                <div class="card-stats-item-label">Tổng số luồng 4k(Đang chạy/Tổng)</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalBOT</div>
                                <div class="card-stats-item-label">Tổng BOT</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalUser</div>
                                <div class="card-stats-item-label">Tổng User</div>
                            </div>
                            <div class="card-stats-item">
                                <div class="card-stats-item-count">@report.TotalManager</div>
                                <div class="card-stats-item-label">Tổng Manager</div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <br />
                        <span></span>
                    </div>
                   
                    
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>@ViewData["Title"]</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="tableAllStream">
                                <thead>
                                    <tr>
                                        <th>Người dùng</th>
                                        <th>BOTName</th>
                                        <th>Group</th>
                                        <th>Tên</th>
                                        <th>Loại</th>
                                        <th>RTMP</th>
                                        <th>Ngày tạo</th>
                                        <th>Thời gian Live</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @item.UserName
                                            </td>
                                            <td>@item.BotName</td>
                                            <td>@item.BotGroup</td>
                                            <th>@item.StreamName</th>
                                            <td>
                                                @item.RTMP
                                            </td>
                                            <td>
                                                <span class="badge badge-primary">@item.PlatformType</span>
                                            </td>
                                            <td>@item.CreatedTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td>@item.Updatedtime?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        $("#tableAllStream").DataTable({

        });
    </script>
}