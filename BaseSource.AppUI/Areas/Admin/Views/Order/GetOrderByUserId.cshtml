@model List<OrderInfoDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="section">
    <div class="section-header">
        <h1>Lịch sử Mua gói</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item"><a href="#">Lịch sử</a></div>
            <div class="breadcrumb-item">Gói live</div>
        </div>
    </div>

    <div class="section-body">

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Lịch sử giao dịch</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="table-transactions">
                                <thead>
                                    <tr>
                                        <th>Loại</th>
                                        <th>Mã hóa đơn</th>
                                        <th>Số tháng</th>
                                        <th>Ngày tạo</th>
                                        <th>Số tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Luồng</th>
                                        <th>Ngày hết hạn</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null)
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @switch (item.Type)
                                                    {
                                                        case ServicePackType._1080:
                                                            <span class="badge badge-success">1080</span>
                                                            break;
                                                        case ServicePackType._4K:
                                                            <span class="badge badge-danger">4k</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>@item.OrderId</td>
                                                <td>@item.Month</td>
                                                <td>@item.CreatedTimeString</td>
                                                <td>@item.Price</td>
                                                <td>
                                                    @switch (item.Status)
                                                    {
                                                        case OrderStatus.Success:
                                                            <span class="badge badge-success">Thành công</span>
                                                            break;
                                                        case OrderStatus.Waiting:
                                                            <span class="badge badge-warning">Chờ xử lý</span>
                                                            break;
                                                        case OrderStatus.Cancel:
                                                            <span class="badge badge-danger">Đã hủy</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    @item.NumberOfThreads
                                                </td>
                                                <td>@item.ExpiredTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                <td>
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="badge badge-success">Đang sử dụng</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>