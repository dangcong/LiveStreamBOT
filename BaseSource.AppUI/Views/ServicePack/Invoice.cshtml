@model List<ServicePackByMonthDto>
@{
    ViewData["Title"] = "Invoice";
    var index = 1;
    var packageFirst = Model.FirstOrDefault();
    var setting = ViewBag.Setting as ConfigSettingVm;
    var invoiceInfo = ViewBag.InvoiceInfo as InvoiceCodeInfoDto;
}
<style>
    .theme--light .card-box {
        background-color: #fff;
        border-color: #fff;
        border-radius: 0.35rem;
        border: 0px;
        box-shadow: 0 1px 2px rgb(0 0 0 / 20%);
    }

    .theme--light .btn-icon {
        background: #ccc;
        color: #000;
        border: none;
        padding: 3px 6px 3px 6px;
    }

    .radius35 {
        border-radius: 0.35rem;
    }

    .btn-month-payment {
        height: 130px;
        width: 170px;
    }

    .cur-point {
        cursor: pointer;
    }

    .m-r-15 {
        margin-right: 15px !important;
    }

    .color-red {
        color: #e93636;
    }

    .color-green {
        color: green;
    }

    .font-18 {
        font-size: 18px;
    }

    #img_bank img {
        width: 120px;
        height: 120px
    }

    .text-line-through {
        text-decoration: line-through;
    }

    .theme--light .btn-icon:hover {
        background: #9f9f9f;
    }

    .theme--light .pricing-box-active {
        /* border: 1px solid #ac3bda !important; */
        box-shadow: inset 0px 0px 0px 1px #ac3bda;
        background: #9f9f9f;
    }
</style>
<section class="section theme--light">
    <div class="section-body">

        <div class="row animated fadeInDown">
            <div class="col-12">
                <div class="card">
                    <div class="card-body m-b-10">
                        <div class="panel-body">
                            <div class="clearfix">
                                <div class="pull-left">
                                    <h3 class="text-right"><i class="ti-credit-card"></i> Hóa Đơn</h3>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 pull-left m-t-30">
                                    <address>
                                        <p class="m-t-10"><strong>Tài khoản:</strong> @(invoiceInfo.UserName)</p>
                                        <p class="m-t-10"><strong>Facebook:</strong> @(invoiceInfo.LinkFB)</p>
                                        <p class="m-t-10"><strong>Gói cước hiện tại:</strong> N/A</p>
                                        <p class="m-t-10"><strong>Hạn dùng: </strong> N/A</p>
                                    </address>
                                </div>
                                <div class="col-md-6 pull-right m-t-30 text-right">
                                    <p class="m-t-10"><strong>Mã hóa đơn: </strong> @invoiceInfo.CodeBill</p>
                                    <p class="m-t-10"><strong> Ngày tạo: </strong> @(DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss"))</p>
                                    <p class="m-t-10"><strong> Gói cước: </strong> @invoiceInfo.PackageName</p>
                                    <p class="m-t-10"><strong>Ngày hết hạn: </strong> <span class="expire-date">@(DateTime.Now.AddDays(30).ToString("dd/MM/yyyy HH:mm:ss"))</span></p>
                                    <p class="payment-pending m-t-10 more">
                                        <strong>Trạng thái: </strong> <span class="badge badge-warning"><i class="ion-load-c fa-spin"></i> Đang chờ xử lý</span>
                                    </p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="table-responsive">
                                        <table>
                                            <tbody>
                                                <tr>
                                                    @foreach (var item in Model)
                                                    {
                                                        <td>
                                                            <button type="button" class="btn-month-payment btn-icon cur-point m-r-15 pa-20 btn-month radius35  @(index==1?"pricing-box-active":"")" value="@item.Month"
                                                                    data-discount="@item.Discount" data-month="@item.Month" data-price="@item.Price" data-date="@(DateTime.Now.AddMonths(item.Month).ToString("dd/MM/yyyy :HH:mm:ss"))">
                                                                <div><span>Mua @item.Month Tháng</span></div>
                                                                <div>
                                                                    <div><span class="text-line-through color-red">@item.Price.ToString("N0").Replace(",",".")</span></div>
                                                                    <span><h4>@item.Discount.ToString("N0").Replace(",",".")</h4></span>
                                                                    @if (item.Percent > 0)
                                                                    {
                                                                        <span>Tiết kiệm</span>

                                                                        <span class="font-20"> -@(item.Percent)%</span>
                                                                    }
                                                                </div>
                                                            </button>
                                                        </td>
                                                        index++;
                                                    }


                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <div class="table-responsive">
                                        <table class="table m-t-30">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Sản phẩm</th>
                                                    <th style="text-align: center;">Số tháng</th>

                                                    <th style="text-align: center;">Giá niêm yết</th>
                                                    <th style="text-align: center;">Giảm giá</th>
                                                    <th style="text-align: center;">Ngày còn lại</th>
                                                    <th style="text-align: left;">Mô tả</th>
                                                    <th style="text-align: center;">Tổng cộng</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (packageFirst != null)
                                                {
                                                    <tr>
                                                        <td>1</td>
                                                        <td>@packageFirst.ServicePackName</td>
                                                        <td style="text-align: center;" class="month_text">@packageFirst.Month</td>

                                                        <td style="text-align: center;" class="price_text">@packageFirst.Price</td>
                                                        <td style="text-align: center;" class="discount discount_text color-red font-bold">@packageFirst.Discount  @(packageFirst.Percent > 0 ? $"({packageFirst.Percent}%)" : "")</td>
                                                        <td style="text-align: center;" class="date_remain">0</td>
                                                        <td class="date_remain_text"></td>
                                                        <td style="text-align: center;" class="sub_total">@packageFirst.Discount</td>
                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <br />
                            <div class="row">
                                <div class="col-md-12">
                                    <p>
                                        Bạn hãy chuyển tiền tới tài khoản sau với nội dung chuyển khoản là:
                                        <span class="color-red"><b>@(invoiceInfo.CodeBill)</b> <i data-toggle="tooltip" data-placement="top" title="" class="fa fa-copy color-green" onclick="copyText('iv')" data-original-title="Copy"></i></span>
                                    </p>
                                </div>
                                <div class="col-md-12">
                                    <div class="row align-items-center">
                                        <div class="col-md-2">
                                           @* <div class="qr" id="img_bank" data-toggle="tooltip" data-placement="top" title="" data-original-title="Bấm vào để phóng to"></div>*@
                                            @* <img data-toggle="tooltip" data-placement="top" title="" class="qr" src="/images/sang_qr2.jpg" data-original-title="Bấm vào để phóng to" />*@
                                        </div>
                                        <div class="col-md-10">
                                            <div class="row">
                                                <div class="col-md-12 m-b-15">
                                                    <span class="font-16 m-r-15">Số tài khoản</span>
                                                    <span class="color-green font-18 font-bold">@setting.BankNumber</span>
                                                </div>
                                                <div class="col-md-12 m-b-15">
                                                    <span class="font-16 m-r-15">Chủ tài khoản</span>
                                                    <span class="color-green font-18 font-bold">@setting.BankAccountName</span>
                                                </div>
                                                <div class="col-md-12 m-b-15">
                                                    <span class="font-16 m-r-15">Ngân hàng  </span> <span>
                                                        @setting.BankName
                                                        @* <img style="height: 20px;" src="images/ACB.png" /></span>*@
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 col-no-padding" style="overflow: auto;">
                                    <p class="text-muted well well-sm no-shadow color-red" style="margin-top: 10px; font-weight: bold; font-size: 16px;">
                                        Lưu ý, sau khi chuyển tiền thành công thì mới ấn nút "Xác nhận chuyển tiền", nếu sau 10p mà chưa vào được hệ thống thì chụp ảnh Hóa đơn gửi facebook cho <a href="@(setting.LinkFBAdmin)">Admin</a>
                                    </p>
                                </div>
                            </div>
                            <div class="d-print-none">
                                <div class="text-right">
                                  @*  <a href="javascript:window.print()" class="btn btn-dark waves-effect waves-light"><i class="fa fa-print"></i></a>*@

                                    <button type="button" data-toggle="modal" data-target="#exampleModal" class="btn btn-primary waves-effect waves-light">Thanh toán</button>
                                </div>
                            </div>
                            <form id="form-invoice">
                                <input type="hidden" name="codebill" id="iv" value="@(invoiceInfo.CodeBill)" />
                                <input type="hidden" name="month" value="@packageFirst?.Month" class="month" />
                                <input type="hidden" name="packageName" value="@invoiceInfo.PackageName" />
                                <button type="submit" id="btn_submit_hidden" class="btn btn-primary waves-effect waves-light" style="display:none">Thanh toán</button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>
<div class="modal fade" tabindex="-1" role="dialog" id="exampleModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận thông tin thanh toán</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Sau khi chuyển khoản thành công, vui lòng xác nhận!</p>
            </div>
            <div class="modal-footer bg-whitesmoke br">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" id="btn-confirm-payment" class="btn btn-danger">Xác nhận đã chuyển khoản</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="/lib/qrcodejs/qrcode.js"></script>
    <script type="text/javascript">
        //text: "Html.Raw(Model.WalletBSC)",
        new QRCode(document.getElementById("img_bank"),
            {
                text: "123123"
                // width: 120,
                // height: 120
            });

    </script>
    <script>

        $('.btn-month-payment').click(function (e) {
            $('.btn-month-payment').removeClass('pricing-box-active');
            $(this).addClass('pricing-box-active');
            $('.month_text').html($(this).attr('data-month'));
            $('input[name="month"]').val($(this).attr('data-month'));
            $('.discount_text').html($(this).attr('data-discount'));
            $('.price_text').html($(this).attr('data-price'));
            $('.sub_total').html($(this).attr('data-discount'));
            $('.expire-date').html($(this).attr('data-date'));
        });
        $('body').on('click', '#btn-confirm-payment', function () {
            $('#btn_submit_hidden').click();
        });
        $('body').on('submit', '#form-invoice', function (e) {
            e.preventDefault();
            console.log('form submit');
            $.ajax({
                type: "POST",
                url: "/order/create",
                data: $(this).serialize(),
                success: function (response) {
                    switch (response.code) {
                        case 1:
                            window.location = '/account/profile';
                            break;
                        case -2:
                            iziToast.error({
                                title: 'Lỗi!',
                                message: response.err,
                                position: 'topRight'
                            });
                            break;
                    }

                }
            });
        });
    </script>
}

