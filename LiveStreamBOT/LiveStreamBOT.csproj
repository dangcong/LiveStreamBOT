<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\ProjectBuildProperties.targets" />

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<!-- GitVersion bật để sinh class GitVersionInformation; auto-update đọc GitVersionInformation.AssemblySemFileVer lúc runtime. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FFmpegArgs.Executes" Version="2.2.0" />
		<PackageReference Include="GitVersion.MsBuild" Version="6.5.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="7.0.2" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.17.0" />
		<PackageReference Include="System.Diagnostics.PerformanceCounter" Version="7.0.0" />
		<PackageReference Include="System.Management" Version="7.0.2" />
		<PackageReference Include="TqkLibrary.Http.Api.CloudStorage.Dropbox" Version="1.1.21" />
		<PackageReference Include="TqkLibrary.Http.Api.CloudStorage.GoogleDrive" Version="1.1.21" />
		<PackageReference Include="TqkLibrary.Http.Api.CloudStorage.OneDrive" Version="1.1.21" />
		<PackageReference Include="TqkLibrary.Concurrency" Version="1.0.1" />
		<PackageReference Include="TypedSignalR.Client" Version="3.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BaseSouce.SharedSignalrData\BaseSouce.SharedSignalrData.csproj" />
		<ProjectReference Include="..\BaseSouce.Shared\BaseSource.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Run.bat">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Run.sh">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!--
		Đóng gói bản publish thành zip rồi upload lên server cập nhật (per-RID) qua endpoint BotUpdate/Publish.
		Bắt buộc publish kèm -r <rid> và BotUpdateBaseUrl (đặt trong publish profile vd PublishLinux.pubxml, hoặc -p:BotUpdateBaseUrl=...).
		Vd: dotnet publish -c Release /p:PublishProfile=PublishLinux
		Theo mẫu UploadYoutubeBotAvalonia/UploadYoutubeBotAvalonia.csproj (ZipAndUpload).
	-->
	<Target Name="ZipAndUpload" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
		<Error Condition="'$(GitVersion_BranchName)' != 'master' AND '$(GitVersion_BranchName)' != 'main' AND '$(GitVersion_BranchName)' != 'tqk/master'" Text="❌ Lỗi: Bạn đang ở nhánh '$(GitVersion_BranchName)'. Chỉ được phép Publish và Upload từ nhánh 'master'/'main'/'tqk/master'!" />
		<Error Condition="'$(RuntimeIdentifier)' == ''" Text="❌ Lỗi: Phải publish kèm RuntimeIdentifier, vd: dotnet publish -c Release -r win-x64" />
		<Error Condition="'$(BotUpdateBaseUrl)' == ''" Text="❌ Lỗi: Thiếu BotUpdateBaseUrl (domain server cập nhật). Truyền -p:BotUpdateBaseUrl=https://your-domain" />
		<PropertyGroup>
			<SourceDir>$(PublishDir)</SourceDir>
			<_PkgVersion>$(GitVersion_MajorMinorPatch).$(GitVersion_CommitsSinceVersionSource)</_PkgVersion>
			<ZipFile>$(OutputPath)$(AssemblyName)_$(_PkgVersion)_$(RuntimeIdentifier).zip</ZipFile>
			<UploadUrl>$(BotUpdateBaseUrl.TrimEnd('/'))/api/BotUpdate/Publish?version=$(_PkgVersion)&amp;rid=$(RuntimeIdentifier)</UploadUrl>
		</PropertyGroup>

		<ItemGroup>
			<OldZipFiles Include="$(OutputPath)$(AssemblyName)_*_$(RuntimeIdentifier).zip" />
		</ItemGroup>
		<Delete Files="@(OldZipFiles)" />

		<ZipDirectory SourceDirectory="$(SourceDir)" DestinationFile="$(ZipFile)" Overwrite="true" />

		<Exec Command="powershell -Command &quot;Invoke-RestMethod -Uri '$(UploadUrl)' -Method Post -InFile '$(ZipFile)' -ContentType 'application/zip'&quot;" />
	</Target>

</Project>
