@using BaseSource.ViewModels.ManagerBOT;
@model StreamClientInfoDto
@{
    ViewData["Title"] = "Edit";
    var bots = ViewBag.Bots as List<UserBotDto>;
}
<section class="section">
    <div class="section-header">
        <h1>Cấu hình</h1>
        <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
            <div class="breadcrumb-item"><a href="#">Cấu hình</a></div>
            <div class="breadcrumb-item">Cấu hình LIVE</div>
        </div>
    </div>
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">

                <div class="card">
                    <form asp-action="Edit" class="needs-validation" novalidate="">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="Id" type="hidden" />
                        <div class="card-header">
                            <h4>Cấu hình</h4>
                        </div>
                        <div class="card-body">
                            <div class="section-title">Cấu hình</div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" id="live1080" value="1" checked="@(Model.LiveType==LiveType._1080)" name="LiveType" class="custom-control-input">
                                <label class="custom-control-label" for="live1080">Live 1080</label>
                            </div>
                            <div class="custom-control custom-radio custom-control-inline">
                                <input type="radio" id="live4k" value="2" checked="@(Model.LiveType==LiveType._4K)" name="LiveType" class="custom-control-input">
                                <label class="custom-control-label" for="live4k">Live 4k</label>
                            </div>
                            <div class="form-group">
                                <label>Tên luồng live</label>
                                <input asp-for="StreamName" placeholder="Đặt tên để gợi nhớ" class="form-control" required="">
                                <span asp-validation-for="StreamName" class="text-danger"></span>
                            </div>
                            <div style="display:none">
                                <div class="section-title">Nền tảng</div>
                                <div class="custom-control custom-radio custom-control-inline">
                                    <input type="radio" id="youtube" value="1" checked="@(Model.PlatformType==PlatformType.Youtube)" name="PlatformType" class="custom-control-input">
                                    <label class="custom-control-label" for="youtube">Youtube</label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Chọn BOT<span class="text-danger">(Vui lòng chọn đúng cấu hình BOT - [4k-1080])</span></label>
                                <select class="form-control select2" asp-for="ManagerBOTId" id="botSelect">
                                    <option value="0" data-type="1">--Chọn BOT--</option>
                                    <option value="0" data-type="2">--Chọn BOT--</option>

                                    @foreach (var item in bots)
                                    {
                                        @if (item.Type != LiveType._Backup)
                                        {
                                            <option value="@item.BotId" data-type="@((int)item.Type)">@item.BotName - @(item.Group)(@(item.NumberOfThreadsInRun) / @(item.NumberOfThreads))</option>
                                        }
                                    }
                                </select>

                                <span asp-validation-for="ManagerBOTId" class="text-danger"></span>
                            </div>
                            <div class="form-group" style="display:none">
                                <label>RTMP</label>
                                <input class="form-control" disabled asp-for="RTMP" />
                                <span asp-validation-for="RTMP" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Thời gian chờ Backup <span class="text-danger">(Phút)</span></label>
                                <input class="form-control" min="0" required asp-for="TimeBackup" type="number" />
                                <span asp-validation-for="TimeBackup" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Chọn BOT Backup<span class="text-danger">(Nếu không Backup thì để trống)</span></label>
                                <select class="form-control select2" asp-for="ManagerBotBackupId">
                                    <option value="0">--Chọn BOT--</option>
                                    @foreach (var item in bots)
                                    {
                                        if (item.Type == LiveType._Backup)
                                        {
                                            <option value="@item.BotId">@item.BotName - @(item.Group)(@(item.NumberOfThreadsInRun) / @(item.NumberOfThreadsBackup) / @(item.NumberOfThreads))</option>
                                        }
                                    }
                                </select>

                                <span asp-validation-for="ManagerBotBackupId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Khóa luồng</label>
                                <input class="form-control" required asp-for="StreamKey" />
                                <span asp-validation-for="StreamKey" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Link Video <span class="text-danger">* Bắt buộc</span></label>
                                <input class="form-control" required asp-for="Video" rows="1" />
                                <span asp-validation-for="Video" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Link Audio <span class="text-danger">* Bắt buộc</span></label>
                                <input class="form-control" required asp-for="Audio" rows="1" />
                                <span asp-validation-for="Audio" class="text-danger"></span>
                            </div>
                            <div class="section-title">Hẹn lịch -  <span class="text-danger"> * Lưu ý: Live 24.7 thì không chọn thời gian kết thúc</span></div>
                            <div class="form-group">
                                <label>Thời gian bắt đầu <span class="text-danger">* Bắt buộc</span></label>
                                <input type="datetime-local" required asp-for="StartTimeLive" class="form-control col-6" placeholder="Thời gian bắt đầu">
                            </div>
                            <div class="form-group">
                                <label>Thời gian kết thúc</label>
                                <input type="datetime-local" asp-for="EndTimeLive" class="form-control col-6" placeholder="Thời gian kết thúc">
                            </div>
                            <button class="btn btn-warning" type="button" onclick="myFunction()">Reset thời gian</button>
                        </div>
                        <div class="card-footer text-left">
                            <button class="btn btn-primary">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts{
    <script>
        function myFunction() {
            $('#StartTimeLive').val('');
            $('#EndTimeLive').val('');
        }
        $('body').on('change', 'input[name="LiveType"]', function () {
            refeshBOT();

        })
        function refeshBOT() {

            var selectedType = $('input[name="LiveType"]:checked').val()
            console.log(selectedType);
            // // Đặt lại select Type
            // $('#serverSelect').val();
            // Ẩn tất cả các tùy chọn
            $('#botSelect option').hide();

            // Hiển thị tùy chọn dựa trên data-server
            $('#botSelect option[data-type="' + selectedType + '"]').show();
            // Chọn tùy chọn đầu tiên trong danh sách hiển thị
            $('#botSelect option[data-type="' + selectedType + '"]').eq(0).prop('selected', true);
            // Vô hiệu hóa và kích hoạt lại Select2


            // Ẩn tất cả các options trong Supplier select
            $('#botSelect option').each(function () {
                if ($(this).data('type') != selectedType) {
                    $(this).attr('disabled', 'disabled');
                } else {
                    $(this).removeAttr('disabled');
                }
            });
            $("#botSelect").select2('destroy').val("").select2();

            setTimeout(function () {
                $(".select2-results__option[aria-disabled='true']").remove();
            }, 500);


        }
        setTimeout(function () {
            var selectedType = $('input[name="LiveType"]:checked').val();
            $('#botSelect option').each(function () {
                if ($(this).data('type') != selectedType) {
                    $(this).attr('disabled', 'disabled');
                } else {
                    $(this).removeAttr('disabled');
                }
            });
        }, 500);

        setInterval(function () {
            $(".select2-results__option[aria-disabled='true']").remove();
        }, 100);

    </script>
}


