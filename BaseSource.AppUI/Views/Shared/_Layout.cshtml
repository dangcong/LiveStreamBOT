<body>
    <div id="app">
        <div class="main-wrapper">
            <div class="navbar-bg"></div>
            <nav class="navbar navbar-expand-lg main-navbar">
                <form class="form-inline mr-auto">
                    <ul class="navbar-nav mr-3">
                        <li><a href="#" data-toggle="sidebar" class="nav-link nav-link-lg"><i class="fas fa-bars"></i></a></li>
                        <li><a href="#" data-toggle="search" class="nav-link nav-link-lg d-sm-none"><i class="fas fa-search"></i></a></li>
                    </ul>
                </form>
                <ul class="navbar-nav navbar-right">

                    <li class="dropdown">
                        <a href="#" data-toggle="dropdown" class="nav-link dropdown-toggle nav-link-lg nav-link-user">
                            <img alt="image" src="~/admin-themes/assets/img/avatar/avatar-1.png" class="rounded-circle mr-1">
                            <div class="d-sm-none d-lg-inline-block">Hi, Admin</div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">

                            <div class="dropdown-divider"></div>
                            <a href="/account/Logout" class="dropdown-item has-icon text-danger">
                                <i class="fas fa-sign-out-alt"></i> Thoát
                            </a>
                        </div>
                    </li>
                </ul>
            </nav>
            <div class="main-sidebar">
                <aside id="sidebar-wrapper">
                    <div class="sidebar-brand">
                        <a href="/bitcoin">AutoLive</a>
                    </div>
                    <div class="sidebar-brand sidebar-brand-sm">
                        <a href="/bitcoin">AutoLive</a>
                    </div>
                    <ul class="sidebar-menu">
                        <li class="nav-item dropdown active">
                            <a href="#" class="nav-link has-dropdown" data-toggle="dropdown"><i class="fas fa-columns"></i> <span>Gói cước</span></a>
                            <ul class="dropdown-menu">

                                <li><a class="nav-link" href="/live/pricing">Live</a></li>
                                <li><a class="nav-link" href="/live-4k/pricing">Live 4k</a></li>


                            </ul>
                        </li>
                        <li><a class="nav-link" href="/ServicePack"><i class="fas fa-columns"></i> <span>Live Stream</span></a></li>
                        <li><a class="nav-link" href="/admin/Authenticator/EnableAuthenticator"><i class="fas fa-columns"></i> <span>Gói Cước</span></a></li>
                        <li><a class="nav-link" href="/account/profile"><i class="fas fa-columns"></i> <span>Cá nhân</span></a></li>
                        <li><a class="nav-link" href="/admin/Setting/Index"><i class="fas fa-columns"></i> <span>Hướng dẫn</span></a></li>

                    </ul>
                </aside>
            </div>
            <!-- Main Content -->
            <div class="main-content">
                @RenderBody()
                @*<div class="modal fade" role="dialog" id="model2FA">
                    <div class="modal-dialog" role="document">
                    <div class="modal-content">
